{
  "@context": {
    "@version": 1.1,
    "openagrinet": "https://openagrinet.github.io/network-specs/vocab#",
    "SchemeApplication": "openagrinet:SchemeApplication",
    "informationMode": "openagrinet:informationMode",
    "actions": {
      "@id": "openagrinet:publishedAction",
      "@context": {
        "action": "openagrinet:actionName",
        "description": "openagrinet:actionDescription",
        "schema": "openagrinet:actionSchema",
        "attributesAt": "openagrinet:actionAttributesAt"
      }
    },
    "challenge": {
      "@id": "openagrinet:challenge",
      "@context": {
        "methods": {
          "@id": "openagrinet:challengeMethods",
          "@context": {
            "method": "openagrinet:challengeMethod",
            "channel": "openagrinet:challengeChannel",
            "length": "openagrinet:challengeLength",
            "valueType": "openagrinet:challengeValueType"
          }
        },
        "issued": {
          "@id": "openagrinet:challengeIssued",
          "@context": {
            "method": "openagrinet:challengeMethod",
            "channel": "openagrinet:challengeChannel",
            "length": "openagrinet:challengeLength",
            "valueType": "openagrinet:challengeValueType",
            "expiresAt": "openagrinet:challengeExpiresAt"
          }
        },
        "response": {
          "@id": "openagrinet:challengeResponse",
          "@context": {
            "method": "openagrinet:challengeMethod",
            "value": "openagrinet:challengeValue"
          }
        }
      }
    },
    "provider": {
      "@id": "openagrinet:provider",
      "@context": "https://schema.beckn.io/Provider/v2.1/context.jsonld"
    },
    "scheme": {
      "@id": "openagrinet:scheme",
      "@context": "https://schema.beckn.io/Descriptor/v2.1/context.jsonld"
    },
    "enrolmentId": "openagrinet:enrolmentId",
    "applicant": {
      "@id": "openagrinet:applicant",
      "@context": {
        "mobile": "openagrinet:applicantMobile"
      }
    },
    "application": {
      "@id": "openagrinet:application",
      "@context": {
        "registeredOn": "openagrinet:registeredOn",
        "latestInstalmentPaid": "openagrinet:latestInstalmentPaid",
        "ekyc": {
          "@id": "openagrinet:ekycStatus",
          "@context": "https://schema.beckn.io/Descriptor/v2.1/context.jsonld"
        },
        "blockers": {
          "@id": "openagrinet:applicationBlockers",
          "@container": "@set",
          "@context": "https://schema.beckn.io/Descriptor/v2.1/context.jsonld"
        }
      }
    }
  }
}
