{
  "@context": {
    "@version": 1.1,
    "schema": "https://schema.org/",
    "beckn": "https://schema.beckn.io/",
    "openagrinet": "https://schemas.openagrinet.global/vocab#",
    "AgricultureResource": "openagrinet:AgricultureResource",
    "subjectAreas": {
      "@id": "openagrinet:subjectAreas",
      "@container": "@set"
    },
    "subjectScope": "openagrinet:subjectScope",
    "agricultureSubjects": {
      "@id": "openagrinet:agricultureSubjects",
      "@container": "@set"
    },
    "AgricultureSubjectReference": "openagrinet:AgricultureSubjectReference",
    "subjectId": {
      "@id": "openagrinet:subjectId",
      "@type": "@id"
    },
    "subjectType": "openagrinet:subjectType",
    "descriptor": "beckn:descriptor",
    "languages": {
      "@id": "openagrinet:languages",
      "@container": "@set"
    },
    "coverageAreaCodes": {
      "@id": "openagrinet:coverageAreaCodes",
      "@container": "@set"
    },
    "sourceId": "openagrinet:sourceId",
    "sourceName": "openagrinet:sourceName",
    "sourceUri": "openagrinet:sourceUri",
    "startsAt": "openagrinet:startsAt",
    "endsAt": "openagrinet:endsAt"
  }
}
