{
  "@context": {
    "openagrinet": "https://schemas.openagrinet.global/vocab#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#"
  },
  "@graph": [
    {
      "@id": "openagrinet:AgricultureResource",
      "@type": "rdfs:Class",
      "rdfs:label": "Agriculture Resource",
      "rdfs:comment": "Shared agriculture attributes attached to a Beckn Resource."
    },
    {
      "@id": "openagrinet:subjectAreas",
      "@type": "rdfs:Property",
      "rdfs:label": "subject areas",
      "rdfs:comment": "Agriculture subjects used to classify a Resource for discovery."
    },
    {
      "@id": "openagrinet:AgricultureSubjectReference",
      "@type": "rdfs:Class",
      "rdfs:label": "Agriculture Subject Reference",
      "rdfs:comment": "Stable reference to a governed agriculture subject and its Beckn descriptor."
    },
    { "@id": "openagrinet:subjectScope", "@type": "rdfs:Property", "rdfs:label": "subject scope" },
    { "@id": "openagrinet:agricultureSubjects", "@type": "rdfs:Property", "rdfs:label": "agriculture subjects" },
    { "@id": "openagrinet:subjectId", "@type": "rdfs:Property", "rdfs:label": "subject identifier" },
    { "@id": "openagrinet:subjectType", "@type": "rdfs:Property", "rdfs:label": "subject type" },
    {
      "@id": "openagrinet:languages",
      "@type": "rdfs:Property",
      "rdfs:label": "languages",
      "rdfs:comment": "BCP 47 languages supported by or present in a Resource."
    },
    {
      "@id": "openagrinet:coverageAreaCodes",
      "@type": "rdfs:Property",
      "rdfs:label": "coverage area codes",
      "rdfs:comment": "Governed geographic areas within which a Resource applies."
    },
    {
      "@id": "openagrinet:sourceId",
      "@type": "rdfs:Property",
      "rdfs:label": "source identifier"
    },
    {
      "@id": "openagrinet:sourceName",
      "@type": "rdfs:Property",
      "rdfs:label": "source name"
    },
    {
      "@id": "openagrinet:sourceUri",
      "@type": "rdfs:Property",
      "rdfs:label": "source URI"
    },
    {
      "@id": "openagrinet:startsAt",
      "@type": "rdfs:Property",
      "rdfs:label": "starts at"
    },
    {
      "@id": "openagrinet:endsAt",
      "@type": "rdfs:Property",
      "rdfs:label": "ends at"
    }
  ]
}
