{
  "@context": {
    "openagrinet": "https://openagrinet.github.io/network-specs/vocab#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#"
  },
  "@graph": [
    {"@id": "openagrinet:publishedAction", "@type": "rdfs:Property", "rdfs:label": "Published action"},
    {"@id": "openagrinet:actionName", "@type": "rdfs:Property", "rdfs:label": "Beckn action name"},
    {"@id": "openagrinet:operationRef", "@type": "rdfs:Property", "rdfs:label": "OpenAPI operation reference"},
    {
      "@id": "openagrinet:AgricultureResource",
      "@type": "rdfs:Class",
      "rdfs:label": "Agriculture Resource",
      "rdfs:comment": "Shared agriculture attributes attached to a Beckn Resource."
    },
    {
      "@id": "openagrinet:informationMode",
      "@type": "rdfs:Property",
      "rdfs:label": "information mode",
      "rdfs:comment": "Whether obtaining specific information requires a Provider invocation or the Resource already contains or directly references that information."
    },
    {
      "@id": "openagrinet:subjectCategories",
      "@type": "rdfs:Property",
      "rdfs:label": "subject categories",
      "rdfs:comment": "Broad agriculture categories used to classify a Resource for discovery."
    },
    {
      "@id": "openagrinet:AgricultureSubjectReference",
      "@type": "rdfs:Class",
      "rdfs:label": "Agriculture Subject Reference",
      "rdfs:comment": "Stable reference to a governed agriculture subject and its Beckn descriptor."
    },
    {
      "@id": "openagrinet:agricultureSubjects",
      "@type": "rdfs:Property",
      "rdfs:label": "agriculture subjects"
    },
    {
      "@id": "openagrinet:subjectId",
      "@type": "rdfs:Property",
      "rdfs:label": "subject identifier"
    },
    {
      "@id": "openagrinet:languages",
      "@type": "rdfs:Property",
      "rdfs:label": "languages",
      "rdfs:comment": "BCP 47 languages supported by or present in a Resource."
    },
    {
      "@id": "openagrinet:coverageAreas",
      "@type": "rdfs:Property",
      "rdfs:label": "coverage areas",
      "rdfs:comment": "Geographic areas within which a Resource applies, represented by an administrative area reference or a Beckn GeoJSON geometry."
    },
    {
      "@id": "openagrinet:AdministrativeAreaReference",
      "@type": "rdfs:Class",
      "rdfs:label": "Administrative Area Reference"
    },
    {
      "@id": "openagrinet:areaCodeScheme",
      "@type": "rdfs:Property",
      "rdfs:label": "area code scheme"
    },
    {
      "@id": "openagrinet:areaCode",
      "@type": "rdfs:Property",
      "rdfs:label": "area code"
    },
    {
      "@id": "openagrinet:areaLevel",
      "@type": "rdfs:Property",
      "rdfs:label": "area level"
    },
    {
      "@id": "openagrinet:areaName",
      "@type": "rdfs:Property",
      "rdfs:label": "area name"
    },
    {
      "@id": "openagrinet:sourceId",
      "@type": "rdfs:Property",
      "rdfs:label": "source identifier"
    },
    {
      "@id": "openagrinet:sourceName",
      "@type": "rdfs:Property",
      "rdfs:label": "source name"
    },
    {
      "@id": "openagrinet:sourceUri",
      "@type": "rdfs:Property",
      "rdfs:label": "source URI"
    },
    {
      "@id": "openagrinet:startsAt",
      "@type": "rdfs:Property",
      "rdfs:label": "starts at"
    },
    {
      "@id": "openagrinet:endsAt",
      "@type": "rdfs:Property",
      "rdfs:label": "ends at"
    },
    {
      "@id": "openagrinet:applicability",
      "@type": "rdfs:Property",
      "rdfs:label": "applicability",
      "rdfs:comment": "Alternative condition sets; fields within one set apply together."
    },
    {
      "@id": "openagrinet:subjectIds",
      "@type": "rdfs:Property",
      "rdfs:label": "subjectIds",
      "rdfs:comment": "Governed subjects for one condition."
    },
    {
      "@id": "openagrinet:seasons",
      "@type": "rdfs:Property",
      "rdfs:label": "seasons",
      "rdfs:comment": "Regional season references."
    },
    {
      "@id": "openagrinet:growthStages",
      "@type": "rdfs:Property",
      "rdfs:label": "growthStages",
      "rdfs:comment": "Observed developmental stage references."
    },
    {
      "@id": "openagrinet:relativeTiming",
      "@type": "rdfs:Property",
      "rdfs:label": "relativeTiming",
      "rdfs:comment": "Inclusive days since a named event."
    },
    {
      "@id": "openagrinet:event",
      "@type": "rdfs:Property",
      "rdfs:label": "event",
      "rdfs:comment": "Event used as day zero."
    },
    {
      "@id": "openagrinet:fromDays",
      "@type": "rdfs:Property",
      "rdfs:label": "fromDays",
      "rdfs:comment": "Inclusive lower day bound."
    },
    {
      "@id": "openagrinet:toDays",
      "@type": "rdfs:Property",
      "rdfs:label": "toDays",
      "rdfs:comment": "Inclusive upper day bound."
    },
    {
      "@id": "openagrinet:establishmentMethods",
      "@type": "rdfs:Property",
      "rdfs:label": "establishmentMethods",
      "rdfs:comment": "Direct seeding or transplanting."
    },
    {
      "@id": "openagrinet:waterRegimes",
      "@type": "rdfs:Property",
      "rdfs:label": "waterRegimes",
      "rdfs:comment": "Rainfed or irrigated."
    },
    {
      "@id": "openagrinet:extensions",
      "@type": "rdfs:Property",
      "rdfs:label": "extensions",
      "rdfs:comment": "Provider-owned restrictions; unknown qualifiers cannot be ignored."
    },
    {
      "@id": "openagrinet:codeSystem",
      "@type": "rdfs:Property",
      "rdfs:label": "codeSystem",
      "rdfs:comment": "Versioned vocabulary URI."
    },
    {
      "@id": "openagrinet:agronomicCode",
      "@type": "rdfs:Property",
      "rdfs:label": "agronomicCode",
      "rdfs:comment": "Code within a vocabulary."
    },
    {
      "@id": "openagrinet:agronomicLabel",
      "@type": "rdfs:Property",
      "rdfs:label": "agronomicLabel",
      "rdfs:comment": "Display label."
    }
  ]
}
