{
  "@context": {
    "openagrinet": "https://schemas.openagrinet.global/vocab#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#"
  },
  "@graph": [
    {
      "@id": "openagrinet:WeatherAdvisory",
      "@type": "rdfs:Class",
      "rdfs:label": "Weather Advisory",
      "rdfs:comment": "Weather-informed agricultural guidance issued for a place and validity period."
    },
    {
      "@id": "openagrinet:topics",
      "@type": "rdfs:Property",
      "rdfs:label": "topics"
    },
    { "@id": "openagrinet:supportedWeatherParameters", "@type": "rdfs:Property", "rdfs:label": "supported weather parameters" },
    { "@id": "openagrinet:forecastHorizon", "@type": "rdfs:Property", "rdfs:label": "forecast horizon" },
    { "@id": "openagrinet:updateFrequency", "@type": "rdfs:Property", "rdfs:label": "update frequency" },
    { "@id": "openagrinet:geographicGranularities", "@type": "rdfs:Property", "rdfs:label": "geographic granularities" },
    {
      "@id": "openagrinet:location",
      "@type": "rdfs:Property",
      "rdfs:label": "location"
    },
    {
      "@id": "openagrinet:issuedAt",
      "@type": "rdfs:Property",
      "rdfs:label": "issued at"
    },
    {
      "@id": "openagrinet:recommendations",
      "@type": "rdfs:Property",
      "rdfs:label": "recommendations"
    },
    { "@id": "openagrinet:topic", "@type": "rdfs:Property", "rdfs:label": "topic" },
    { "@id": "openagrinet:message", "@type": "rdfs:Property", "rdfs:label": "message" },
    { "@id": "openagrinet:priority", "@type": "rdfs:Property", "rdfs:label": "priority" },
    { "@id": "openagrinet:actions", "@type": "rdfs:Property", "rdfs:label": "actions" },
    { "@id": "openagrinet:weatherBasis", "@type": "rdfs:Property", "rdfs:label": "weather basis" },
    { "@id": "openagrinet:weatherParameters", "@type": "rdfs:Property", "rdfs:label": "weather parameters" },
    { "@id": "openagrinet:supportingResourceIds", "@type": "rdfs:Property", "rdfs:label": "supporting Resource identifiers" }
  ]
}
