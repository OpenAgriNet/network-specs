{
  "schema": "KnowledgeResource",
  "version": "0.1.0",
  "card_template": "{{informationMode}} | {{knowledgeType}} | {{topics}} | {{languages}} | {{lifecycleStatus}}",
  "detail_template": "Mode: {{informationMode}}\nTopics: {{topics}}\nSupported types: {{supportedKnowledgeTypes}}\nType: {{knowledgeType}}\nLanguages: {{languages}}\nVersion: {{version}}\nStatus: {{lifecycleStatus}}\nPublished: {{provenance.publishedAt}}",
  "html": "<div class=\"oan-knowledge\"><strong>{{informationMode}}</strong><span>{{knowledgeType}}</span><span>{{topics}}</span><span>{{languages}} · {{lifecycleStatus}}</span></div>",
  "html_detail": "<div class=\"oan-knowledge-detail\"><p><strong>Mode:</strong> {{informationMode}}</p><p><strong>Topics:</strong> {{topics}}</p><p><strong>Supported types:</strong> {{supportedKnowledgeTypes}}</p><p><strong>Version:</strong> {{version}}</p><p><strong>Status:</strong> {{lifecycleStatus}}</p><p><strong>Published:</strong> {{provenance.publishedAt}}</p></div>"
}
