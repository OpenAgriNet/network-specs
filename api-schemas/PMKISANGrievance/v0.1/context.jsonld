{
  "@context": {
    "@version": 1.1,
    "openagrinet": "https://openagrinet.github.io/network-specs/vocab#",
    "PMKISANGrievance": "openagrinet:PMKISANGrievance",
    "informationMode": "openagrinet:informationMode",
    "provider": {
      "@id": "openagrinet:provider",
      "@context": "https://schema.beckn.io/Provider/v2.1/context.jsonld"
    },
    "scheme": {
      "@id": "openagrinet:scheme",
      "@context": "https://schema.beckn.io/Descriptor/v2.1/context.jsonld"
    },
    "enrolmentId": "openagrinet:enrolmentId",
    "grievance": {
      "@id": "openagrinet:grievance",
      "@context": {
        "category": {
          "@id": "openagrinet:pmkisanGrievanceCategory",
          "@context": "https://schema.beckn.io/Descriptor/v2.1/context.jsonld"
        },
        "description": "openagrinet:grievanceDescription"
      }
    },
    "case": {
      "@id": "openagrinet:case",
      "@context": {
        "status": {
          "@id": "openagrinet:caseStatus",
          "@context": "https://schema.beckn.io/Descriptor/v2.1/context.jsonld"
        },
        "filedOn": "openagrinet:filedOn",
        "remark": "openagrinet:caseRemark",
        "remarkedOn": "openagrinet:remarkedOn"
      }
    }
  }
}
