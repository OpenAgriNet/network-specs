{
  "@context": {
    "@version": 1.1,
    "openagrinet": "https://openagrinet.github.io/network-specs/vocab#",
    "PMKISANGrievance": "openagrinet:PMKISANGrievance",
    "informationMode": "openagrinet:informationMode",
    "challengeMethods": {
      "@id": "openagrinet:challengeMethods",
      "@context": {
        "method": "openagrinet:challengeMethod",
        "length": "openagrinet:challengeLength",
        "valueType": "openagrinet:challengeValueType"
      }
    },
    "grievanceOptions": {
      "@id": "openagrinet:grievanceOptions",
      "@context": {
        "categories": {
          "@id": "openagrinet:grievanceCategoryOption",
          "@context": {
            "code": "openagrinet:optionCode",
            "name": "openagrinet:optionName",
            "descriptor": "openagrinet:optionDescriptor"
          }
        },
        "subCategories": {
          "@id": "openagrinet:grievanceSubCategoryOption",
          "@context": {
            "code": "openagrinet:optionCode",
            "name": "openagrinet:optionName",
            "descriptor": "openagrinet:optionDescriptor"
          }
        }
      }
    },
    "provider": {
      "@id": "openagrinet:provider",
      "@context": "https://schema.beckn.io/Provider/v2.1/context.jsonld"
    },
    "scheme": {
      "@id": "openagrinet:scheme",
      "@context": "https://schema.beckn.io/Descriptor/v2.1/context.jsonld"
    },
    "enrolmentId": "openagrinet:enrolmentId",
    "grievance": {
      "@id": "openagrinet:grievance",
      "@context": {
        "category": {
          "@id": "openagrinet:pmkisanGrievanceCategory",
          "@context": "https://schema.beckn.io/Descriptor/v2.1/context.jsonld"
        },
        "description": "openagrinet:grievanceDescription"
      }
    },
    "case": {
      "@id": "openagrinet:case",
      "@context": {
        "ticketNo": "openagrinet:ticketNo",
        "status": {
          "@id": "openagrinet:caseStatus",
          "@context": "https://schema.beckn.io/Descriptor/v2.1/context.jsonld"
        },
        "filedOn": "openagrinet:filedOn",
        "remark": "openagrinet:caseRemark",
        "remarkedOn": "openagrinet:remarkedOn"
      }
    },
    "challenge": {
      "@id": "openagrinet:challenge",
      "@context": {
        "method": "openagrinet:challengeMethod",
        "value": "openagrinet:challengeValue"
      }
    },
    "challengeIssued": {
      "@id": "openagrinet:challengeIssued",
      "@context": {
        "method": "openagrinet:challengeMethod",
        "length": "openagrinet:challengeLength",
        "valueType": "openagrinet:challengeValueType",
        "expiresAt": "openagrinet:challengeExpiresAt"
      }
    }
  }
}
