{
  "schema": "PMKISANGrievance",
  "version": "0.1.0",
  "card_template": "{{informationMode}} | {{scheme.name}} | {{case.status.name}} | {{case.filedOn}}",
  "detail_template": "Mode: {{informationMode}}\nScheme: {{scheme.name}}\nStatus: {{case.status.name}}\nFiled on: {{case.filedOn}}\nCategory: {{grievance.category.name}}\nGrievance: {{grievance.description}}\nLatest remark: {{case.remark}}\nRemarked on: {{case.remarkedOn}}",
  "html": "<div class=\"oan-pmkisan-grievance\"><strong>{{informationMode}}</strong><span>{{scheme.name}} · {{case.status.name}} · {{case.filedOn}}</span></div>",
  "html_detail": "<div class=\"oan-pmkisan-grievance-detail\"><p><strong>Status:</strong> {{case.status.name}}</p><p><strong>Filed on:</strong> {{case.filedOn}}</p><p><strong>Category:</strong> {{grievance.category.name}}</p><p><strong>Grievance:</strong> {{grievance.description}}</p><p><strong>Latest remark:</strong> {{case.remark}}</p></div>"
}
