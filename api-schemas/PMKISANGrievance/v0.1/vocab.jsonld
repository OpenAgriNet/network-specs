{
  "@context": {
    "openagrinet": "https://openagrinet.github.io/network-specs/vocab#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#"
  },
  "@graph": [
    {
      "@id": "openagrinet:PMKISANGrievance",
      "@type": "rdfs:Class",
      "rdfs:label": "PM-KISAN Grievance",
      "rdfs:comment": "A grievance raised against the Pradhan Mantri Kisan Samman Nidhi income-support scheme, filed on demand and answered directly. The scheme issues no ticket number; a grievance is retrieved by the identity it was filed under."
    },
    {
      "@id": "openagrinet:informationMode",
      "@type": "rdfs:Property",
      "rdfs:label": "information mode",
      "rdfs:comment": "Direction of the payload: OnDemand is the ask, Direct is an answer carrying a real case."
    },
    {
      "@id": "openagrinet:challengeMethods",
      "@type": "rdfs:Property",
      "rdfs:label": "challenge methods",
      "rdfs:comment": "Which challenge a caller must pass before a grievance can be filed. Non-empty names the mechanism and means the challenge comes first; empty means the portal issues none. Stated on a catalog entry and on no transaction payload."
    },
    {
      "@id": "openagrinet:grievanceOptions",
      "@type": "rdfs:Property",
      "rdfs:label": "grievance options",
      "rdfs:comment": "The choices a caller may make on this desk: the values grievance.category.code and, where the desk classifies at two levels, grievance.subCategory.code may take. Stated on a catalog entry and on no transaction payload."
    },
    {
      "@id": "openagrinet:grievanceCategoryOption",
      "@type": "rdfs:Property",
      "rdfs:label": "grievance category option",
      "rdfs:comment": "One category a grievance may be filed under on this desk. Published, never sent: what is sent is grievance.category, a Descriptor carrying the code named here."
    },
    {
      "@id": "openagrinet:grievanceSubCategoryOption",
      "@type": "rdfs:Property",
      "rdfs:label": "grievance sub-category option",
      "rdfs:comment": "One second-level choice, where the portal numbers one. Omitted -- not empty -- on a desk that classifies at one level, because such a desk refuses grievance.subCategory outright. Nothing here says which sub-category goes with which category."
    },
    {
      "@id": "openagrinet:optionCode",
      "@type": "rdfs:Property",
      "rdfs:label": "option code",
      "rdfs:comment": "The portal's own value for an option, exactly as the matching grievance field must carry it. This is what is sent; the two members beside it are for the caller's screen."
    },
    {
      "@id": "openagrinet:optionName",
      "@type": "rdfs:Property",
      "rdfs:label": "option name",
      "rdfs:comment": "The portal's label for an option -- its words, not ours. Omitted where the portal publishes none, because absent means unknown and an empty string would claim the label is blank."
    },
    {
      "@id": "openagrinet:optionDescriptor",
      "@type": "rdfs:Property",
      "rdfs:label": "option descriptor",
      "rdfs:comment": "Plain-language help text for the farmer choosing an option. Ours, written for the caller's screen, and never sent upstream."
    },
    {
      "@id": "openagrinet:scheme",
      "@type": "rdfs:Property",
      "rdfs:label": "scheme"
    },
    {
      "@id": "openagrinet:grievance",
      "@type": "rdfs:Property",
      "rdfs:label": "grievance",
      "rdfs:comment": "What the farmer submitted: the classification they chose and the problem in their own words. Nothing the portal authored belongs here."
    },
    {
      "@id": "openagrinet:case",
      "@type": "rdfs:Property",
      "rdfs:label": "case",
      "rdfs:comment": "What the portal has on file about a grievance, the stamps it applied included. Every member can differ between two reads of the same grievance."
    },
    {
      "@id": "openagrinet:enrolmentId",
      "@type": "rdfs:Property",
      "rdfs:label": "enrolment id",
      "rdfs:comment": "The enrolment a grievance is about -- the farmer's standing in a scheme, not the farmer. One property across schemes: the value spaces differ and the packs pin them, but an opaque enrolment reference is not a vocabulary anyone reasons over."
    },
    {
      "@id": "openagrinet:provider",
      "@type": "rdfs:Property",
      "rdfs:label": "provider",
      "rdfs:comment": "The provider this grievance is for, as a Beckn Provider reference. Carried on support because a SupportAction composes no Contract to read it from; every other action reads commitments[].offer.provider."
    },
    {
      "@id": "openagrinet:pmkisanGrievanceCategory",
      "@type": "rdfs:Property",
      "rdfs:label": "PM-KISAN grievance category",
      "rdfs:comment": "One of the ten published PM-KISAN codes, G001 to G010. Deliberately a separate property from the PMFBY category: the two schemes publish incompatible value spaces, and one IRI holding both could not be reasoned over."
    },
    {
      "@id": "openagrinet:grievanceDescription",
      "@type": "rdfs:Property",
      "rdfs:label": "grievance description"
    },
    {
      "@id": "openagrinet:ticketNo",
      "@type": "rdfs:Property",
      "rdfs:label": "ticket number"
    },
    {
      "@id": "openagrinet:caseStatus",
      "@type": "rdfs:Property",
      "rdfs:label": "case status"
    },
    {
      "@id": "openagrinet:filedOn",
      "@type": "rdfs:Property",
      "rdfs:label": "filed on"
    },
    {
      "@id": "openagrinet:caseRemark",
      "@type": "rdfs:Property",
      "rdfs:label": "case remark"
    },
    {
      "@id": "openagrinet:remarkedOn",
      "@type": "rdfs:Property",
      "rdfs:label": "remarked on"
    },
    {
      "@id": "openagrinet:challenge",
      "@type": "rdfs:Property",
      "rdfs:label": "challenge"
    },
    {
      "@id": "openagrinet:challengeMethod",
      "@type": "rdfs:Property",
      "rdfs:label": "challenge method"
    },
    {
      "@id": "openagrinet:challengeValue",
      "@type": "rdfs:Property",
      "rdfs:label": "challenge value"
    },
    {
      "@id": "openagrinet:challengeIssued",
      "@type": "rdfs:Property",
      "rdfs:label": "challenge issued"
    },
    {
      "@id": "openagrinet:challengeExpiresAt",
      "@type": "rdfs:Property",
      "rdfs:label": "challenge expires at"
    }
  ]
}
