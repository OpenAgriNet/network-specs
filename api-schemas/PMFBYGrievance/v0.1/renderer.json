{
  "schema": "PMFBYGrievance",
  "version": "0.1.0",
  "card_template": "{{informationMode}} | {{scheme.name}} | {{case.ticketNo}} | {{case.status.code}}",
  "detail_template": "Mode: {{informationMode}}\nScheme: {{scheme.name}}\nTicket: {{case.ticketNo}}\nStatus: {{case.status.code}}\nCategory: {{grievance.category.name}}\nSub-category: {{grievance.subCategory.name}}\nFiled on: {{case.filedOn}}\nGrievance: {{grievance.description}}\nCrop: {{case.cropName}}",
  "html": "<div class=\"oan-pmfby-grievance\"><strong>{{informationMode}}</strong><span>{{scheme.name}} · {{case.ticketNo}} · {{case.status.code}}</span></div>",
  "html_detail": "<div class=\"oan-pmfby-grievance-detail\"><p><strong>Ticket:</strong> {{case.ticketNo}}</p><p><strong>Status:</strong> {{case.status.code}}</p><p><strong>Category:</strong> {{grievance.category.name}} / {{grievance.subCategory.name}}</p><p><strong>Filed on:</strong> {{case.filedOn}}</p><p><strong>Grievance:</strong> {{grievance.description}}</p><p><strong>Crop:</strong> {{case.cropName}}</p></div>"
}
