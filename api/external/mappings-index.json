  "integrationNotes": {
    "agristack-consent": "Only a commented registration marker was found. No provider consent exchange or authorized data read was established.",
    "aif-loan": "The scheme_info tool recognizes AIF as a scheme name. It does not establish the loan OTP or status HTTP contract.",
    "aif-tickets": "The AIF scheme name is known, but no native ticket lookup was traced.",
    "kcc-loan": "The scheme_info tool recognizes KCC; a scheme-name lookup does not establish application or OTP endpoints.",
    "khc-tickets": "The KHC ticket flow is proposed. No native service endpoint or ticket response was established on the reviewed refs.",
    "amul-schemes": "The union_schemes tool uses network /search or a union-scoped Redis cache. Neither is a separate native scheme HTTP interface.",
    "ffs-booking": "The existing caller-derived contract lists four booking-related calls. The owning FFS client was not found in the reviewed tool refs. The proposed init/confirm sequence is not a verified runtime binding.",
    "gfr-advice": "gfr_get_recommendations sends a legacy /search with crop and soil-context inputs. The service composes a recommendation; crop registry is not its result contract.",
    "icar-materials": "The icar-schemes catalog handler queries internal content storage. No separate ICAR HTTP operation was identified.",
    "icar-field-advice": "A material lookup does not establish an actionable ICAR field-advice endpoint or its request schema.",
    "imd-district-forecast": "The provider resolves coordinates to a station and requests a configured URL with id. The path is unverified. This is not the Agromet bulletin feed.",
    "knowledge-answers": "The legacy handler searches Marqo. The replacement Knowledge Provider /search returns passages, not necessarily actionable AgricultureAdvisory records. The v0.1 result mapper is not a v0.2 binding.",
    "knowledge-documents": "The tool uses a scheme-filtered BAP /search. Internal Docs Pipeline /marqo/search returns passages; no whole-document or scheme-filter parity is established.",
    "knowledge-schemes": "Scheme aliases and catalog search are evidenced, not a separate native scheme operation.",
    "mahavistaar-schemes": "maha_vistaar sends BAP /search with scheme code in item.descriptor.code. A similarly named provider handler reads descriptor.name, so it is not a verified match.",
    "market-insights-outlook": "The mandi tool retrieves dated prices. Its response is not a market outlook or forecast.",
    "video-library": "The tool embeds a query and searches an internal video collection. No native video-provider HTTP API was established.",
    "npss-diagnosis": "The tool exchanges a token and uploads image bytes as multipart. A URL or image reference in discovery does not implement that transfer.",
    "pmfby-insurance": "A verified session and authorized farmer ID are prerequisites for the policy and claim reads. The two status operations have different parameters.",
    "agmarknet-nearby-prices": "The original lookup sends user coordinates and a resolved commodity ID, not a selected market ID. The offline query/response transformations do not implement the private name resolver or a complete select binding."
  }
}
